# Must be the EXACT absolute host path mounted to /data.
HYPANEL_HOST_DATA=/mnt/user/appdata/hypanel
# Set for an HTTPS reverse proxy. Leave blank for direct LAN HTTP.
HYPANEL_PUBLIC_URL=
HYPANEL_COOKIE_SECURE=false
# Only trust the IP/CIDR of your reverse proxy, never * on an exposed LAN.
HYPANEL_TRUSTED_PROXIES=127.0.0.1
